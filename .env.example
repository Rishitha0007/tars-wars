# TARS WARS Server Configuration
PORT=3001
NODE_ENV=development

# Organizer / Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_secure_admin_password
JWT_SECRET=change_this_to_a_random_secure_jwt_secret_key

# Quiz Policies
# Allow duplicate attempts per roll number: "true" or "false"
ALLOW_DUPLICATE_ATTEMPTS=false

# Leaderboard display mode for retakes: "best" (highest score) or "first" (earliest completed attempt)
LEADERBOARD_DISPLAY_MODE=best

# Privacy: mask middle digits of roll numbers on public leaderboard ("true" or "false")
MASK_ROLL_NUMBERS=false

# Optional PostgreSQL / Supabase connection string. If omitted, uses local zero-config SQLite.
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=
